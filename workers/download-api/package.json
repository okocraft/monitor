{
	"name": "download-api",
	"version": "0.0.0",
	"private": true,
	"scripts": {
		"deploy": "wrangler deploy",
		"dev": "wrangler dev",
		"start": "wrangler dev",
		"cf-typegen": "wrangler types --include-runtime=false",
		"typecheck": "tsc --noEmit",
		"check": "biome check ./",
		"fix": "biome check --write ./"
	},
	"packageManager": "pnpm@12.11.2",
	"devDependencies": {
		"@cloudflare/workers-types": "5.20261010.1",
		"@biomejs/biome": "2.5.15",
		"typescript": "7.0.2",
		"wrangler": "4.149.0"
	}
}
